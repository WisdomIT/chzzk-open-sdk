{
  "name": "chzzk-open-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for the official CHZZK Open API (openapi.chzzk.naver.com). Official endpoints only — no unofficial/internal APIs.",
  "keywords": [
    "chzzk",
    "치지직",
    "naver",
    "openapi",
    "open-api",
    "sdk",
    "streaming",
    "chat",
    "typescript"
  ],
  "homepage": "https://wisdomit.github.io/chzzk-open-sdk/",
  "bugs": {
    "url": "https://github.com/WisdomIT/chzzk-open-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WisdomIT/chzzk-open-sdk.git"
  },
  "license": "MIT",
  "author": "WisdomIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "login": "tsx scripts/auth/login-server.ts",
    "verify": "tsx scripts/verify/run.ts",
    "verify:token": "tsx scripts/verify/token-raw.ts",
    "prepublishOnly": "pnpm run build",
    "docs:api": "typedoc",
    "docs:dev": "pnpm docs:api && vitepress dev docs",
    "docs:build": "pnpm docs:api && vitepress build docs && node scripts/fix-llms-links.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^20.19.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typedoc-vitepress-theme": "^1.1.3",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.36.0",
    "vitepress": "^1.6.4",
    "vitepress-plugin-llms": "^1.13.3",
    "vitest": "^3.2.0"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
